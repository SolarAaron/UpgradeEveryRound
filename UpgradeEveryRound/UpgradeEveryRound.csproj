<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../Directory.Repo.props"
          Condition="Exists('$(MSBuildThisFileDirectory)../Directory.Repo.props')" />

  <PropertyGroup>
    <GameDirectory Condition="'$(GameDirectory)' == '' and '$(REPO_GAME_DIR)' != ''">$(REPO_GAME_DIR)</GameDirectory>
    <GameAssemblyDir Condition="'$(GameAssemblyDir)' == ''">$(GameDirectory)/REPO_Data/Managed</GameAssemblyDir>
    <BepInExDirectory Condition="'$(BepInExDirectory)' == '' and '$(REPO_BEPINEX_DIR)' != ''">$(REPO_BEPINEX_DIR)</BepInExDirectory>
    <BepInExDirectory Condition="'$(BepInExDirectory)' == ''">$(GameDirectory)/BepInEx</BepInExDirectory>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(BepInExDirectory)/core</BepInExCoreDir>
    <MenuLibAssemblyPath Condition="'$(MenuLibAssemblyPath)' == ''">$(BepInExDirectory)/plugins/REPOModding-MenuLib/MenuLib.dll</MenuLibAssemblyPath>
    <REPOLibAssemblyPath Condition="'$(REPOLibAssemblyPath)' == ''">$(BepInExDirectory)/plugins/Zehs-REPOLib/REPOLib.dll</REPOLibAssemblyPath>
    <AssemblyVersion>3.0.8</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>UpgradeEveryRound</AssemblyName>
    <Product>Upgrade Every Round</Product>
    <Version>3.0.8</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>UpgradeEveryRound</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against the assemblies installed with this REPO build. -->
    <Reference Include="$(GameAssemblyDir)/*.dll"
               Exclude="$(GameAssemblyDir)/mscorlib.dll;$(GameAssemblyDir)/netstandard.dll;$(GameAssemblyDir)/System*.dll">
      <Private>False</Private>
    </Reference>

    <!-- Resolve loader assemblies from the selected local mod profile. -->
    <Reference Include="$(BepInExCoreDir)/0Harmony.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(BepInExCoreDir)/BepInEx.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(BepInExCoreDir)/Mono.Cecil.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(BepInExCoreDir)/MonoMod.RuntimeDetour.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(BepInExCoreDir)/MonoMod.Utils.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(MenuLibAssemblyPath)">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(REPOLibAssemblyPath)">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRepoReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDirectory)' == ''"
           Text="Set REPO_GAME_DIR or provide a local Directory.Repo.props file." />
    <Error Condition="!Exists('$(GameAssemblyDir)/Assembly-CSharp.dll')"
           Text="REPO Assembly-CSharp.dll was not found. Set GameDirectory or provide Directory.Repo.props." />
    <Error Condition="!Exists('$(BepInExCoreDir)/0Harmony.dll') or !Exists('$(BepInExCoreDir)/BepInEx.dll')"
           Text="BepInEx core assemblies were not found. Set BepInExDirectory or provide Directory.Repo.props." />
    <Error Condition="!Exists('$(MenuLibAssemblyPath)') or !Exists('$(REPOLibAssemblyPath)')"
           Text="MenuLib or REPOLib was not found in the selected BepInEx profile." />
  </Target>

</Project>
